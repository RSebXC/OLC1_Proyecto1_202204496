list_varA.añadirHijo(new Arbol($7));
list_varA.añadirHijo(new Arbol($6));
list_varA.añadirHijo(new Arbol($7));
RESULT = list_varA;
:};


tipo_sentencia ::= tipo_sentencia:$0 sentencia:$1{:
Arbol list_varA = new Arbol ("tipo_sentencia");
list_varA.añadirHijo($0);
list_varA.añadirHijo($1);
RESULT = list_varA;
:}
| sentencia:$0{:
Arbol list_varA = new Arbol ("tipo_sentencia");
list_varA.añadirHijo($0);
RESULT = list_varA;
:}
;

